generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Catálogo de servicios eléctricos (residencial y comercial)
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEs    String
  nameEn    String
  descEs    String
  descEn    String
  icon      String   @default("Zap")
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Catálogo de productos eléctricos para pedido del cliente
model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  nameEs    String
  nameEn    String
  descEs    String
  descEn    String
  category  String // clave: panels | evCharging | lighting | protection
  price     Float
  currency  String   @default("USD")
  unit      String?
  inStock   Boolean  @default(true)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Galería de proyectos realizados
model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  location  String?
  image     String?
  descEs    String?
  descEn    String?
  category  String? // residential | commercial | mixed
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Solicitudes de pedido generadas desde el catálogo
model OrderRequest {
  id            String   @id @default(cuid())
  reference     String   @unique
  itemType      String // "product" | "service"
  itemId        String?
  itemName      String
  quantity      Int      @default(1)
  customerName  String
  customerEmail String
  customerPhone String?
  propertyType  String? // "residential" | "commercial"
  serviceCity   String?
  message       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

// Mensajes del formulario de contacto
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

// Suscriptores del boletín de tecnología e iluminación
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
