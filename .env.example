# ─── Supabase ──────────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores reales.
# ⚠️  NUNCA subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Solo en server-side (API Routes / Server Actions) — no exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Organization ID (fijo) ────────────────────────────────────────────────────
NEXT_PUBLIC_ORG_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# ─── SQLite local (solo desarrollo sin Supabase) ───────────────────────────────
DATABASE_URL=file:./dev.db
