# ─── Supabase ──────────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores reales.
# ⚠️  NUNCA subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Solo en server-side (API Routes / Server Actions) — no exponer al cliente.
# Preferida: clave secreta propia de la web (sb_secret_…), creada en Supabase › Settings › API Keys.
SUPABASE_SECRET_KEY=<sb_secret_…>
# Respaldo legacy mientras se migra (se puede dejar vacío si existe SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Organization ID (fijo) ────────────────────────────────────────────────────
NEXT_PUBLIC_ORG_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# ─── SQLite local (solo desarrollo sin Supabase) ───────────────────────────────
DATABASE_URL=file:./dev.db

# ─── Cloudflare Turnstile (captcha de los formularios) ─────────────────────────
# Crear el widget en Cloudflare › Turnstile para el dominio de la web.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key>
# Solo servidor. Sin esta variable la verificación se omite (solo para desarrollo local).
TURNSTILE_SECRET_KEY=<secret-key>
